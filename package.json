{
  "name": "pdf-toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based PDF toolkit: merge, split, rotate and compress PDFs fully client-side.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "fixtures": "node scripts/generate-fixtures.js",
    "screenshots": "node scripts/screenshots.js"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
